base_map <- function(var, title) {
ggplot(nuts3_farms) +
geom_sf(aes(fill = .data[[var]]), color = NA) +
coord_sf(datum = NA) +
labs(title = title, fill = NULL) +
theme_minimal() +
theme(
plot.title = element_text(size = 12, face = "bold"),
legend.position = "right"
)
}
