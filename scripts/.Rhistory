#collect_metrics(lm_cv_results)
lm_final_fit <- fit(
lm_workflow,
data = train_df_imp
)
test_predictions <- predict(lm_final_fit, new_data = test_df) %>%
bind_cols(test_df %>% select(Winterweizen))
yardstick::metrics(
test_predictions,
truth = Winterweizen,
estimate = .pred
)
